@model ExpenseListViewModel

@{
    ViewData["Title"] = "Personal Expense Tracker";
}

<style>
    .main-card {
        background: linear-gradient(135deg, #e8f5e9 0%, #e3f2fd 100%);
        border: none;
        border-radius: 16px;
    }
    .form-card {
        background: #ffffff;
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 15px rgba(0, 122, 255, 0.1);
    }
    .total-card {
        background: linear-gradient(135deg, #4caf50 0%, #81c784 100%);
        border: none;
        border-radius: 16px;
    }
    .total-card.warning {
        background: linear-gradient(135deg, #e53935 0%, #ef5350 100%);
    }
    .btn-add {
        background: linear-gradient(135deg, #42a5f5 0%, #66bb6a 100%);
        border: none;
        border-radius: 10px;
        font-weight: 600;
        transition: all 0.3s ease;
    }
    .btn-add:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(66, 165, 245, 0.4);
    }
    .btn-delete {
        background: #ff8a80;
        border: none;
        border-radius: 8px;
        color: white;
        padding: 6px 12px;
        font-size: 0.85rem;
    }
    .btn-delete:hover {
        background: #d32f2f;
        color: white;
    }
    .expense-table {
        background: white;
        border-radius: 12px;
        overflow: hidden;
    }
    .expense-table thead {
        background: #b3e5fc;
    }
    .expense-table tbody tr:hover {
        background: #f1f8e9;
    }
    .form-label {
        color: #37474f;
        font-weight: 500;
    }
    .form-control {
        border: 2px solid #e0e0e0;
        border-radius: 10px;
        padding: 12px;
    }
    .form-control:focus {
        border-color: #42a5f5;
        box-shadow: 0 0 0 3px rgba(66, 165, 245, 0.2);
    }
    .input-icon {
        position: relative;
    }
    .input-icon svg {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #90a4ae;
    }
    .input-icon input {
        padding-left: 40px;
    }
    h1 {
        color: #263238;
    }
    .total-text {
        font-size: 1.8rem;
        font-weight: 700;
    }
</style>

<div class="container py-4">
    <div class="text-center mb-4">
        <h1 class="fw-bold">My Expense Tracker</h1>
        <p class="text-muted">Track your spending simply</p>
    </div>

    <div class="row">
        <!-- Left Side: Add Expense Form -->
        <div class="col-lg-4 mb-4">
            <div class="card form-card shadow-sm">
                <div class="card-body p-4">
                    <h4 class="mb-4 text-center" style="color: #546e7a;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="me-2" viewBox="0 0 16 16" style="color: #42a5f5;">
                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                            <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
                        </svg>
                        Add Expense
                    </h4>
                    
                    <form asp-action="Create" method="post">
                        <div class="mb-3">
                            <label class="form-label">Expense Name</label>
                            <div class="input-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M2 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2zm2-1a1 1 0 0 0-1 1v1h14V2a1 1 0 0 0-1-1H4zm13 3v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5z"/>
                                </svg>
                                <input type="text" name="Description" class="form-control" placeholder="What did you buy?" required />
                            </div>
                        </div>
                        
                        <div class="mb-4">
                            <label class="form-label">Amount (Pesos)</label>
                            <div class="input-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M4 10.781c.148 1.667 1.513 2.85 3.591 3.003V15h1.5v-.45c.991-.103 1.635-.8 1.635-1.679 0-.814-.629-1.248-1.756-1.246-.987 0-1.876.366-2.45.849l-.655.803c.305.46.753.849 1.348.849H12V6.5H8.273c-.523 0-1.044-.39-1.342-.875l-.76-.996c-.32.305-.673.553-1.077.677V10h1.5v.25c-.15.016-.306.027-.456.027zm3.687-3.281h1.5v-1h-1.5v1z"/>
                                </svg>
                                <input type="number" name="Amount" class="form-control" placeholder="0" min="1" required />
                            </div>
                        </div>
                        
                        <input type="hidden" name="Category" value="Others" />
                        <input type="hidden" name="Date" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        
                        <button type="submit" class="btn btn-add text-white w-100 py-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="me-2" viewBox="0 0 16 16">
                                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                                <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
                            </svg>
                            Add Expense
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Right Side: Expense List and Total -->
        <div class="col-lg-8">
            <!-- Total Display -->
            <div class="card total-card shadow-sm mb-4 text-white @(Model.TotalAmount > 1000 ? "warning" : "")">
                <div class="card-body p-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-1 opacity-75">Total Spending</h5>
                        @if (Model.TotalAmount > 1000)
                        {
                            <p class="mb-0 small opacity-75">Warning: You've exceeded 1,000 pesos!</p>
                        }
                        else
                        {
                            <p class="mb-0 small opacity-75">Keep tracking your expenses</p>
                        }
                    </div>
                    <div class="total-text">
                        ₱@Model.TotalAmount.ToString("N0")
                    </div>
                </div>
            </div>

            <!-- Expense Table -->
            <div class="card shadow-sm">
                <div class="card-header" style="background: #81c784; color: white;">
                    <h5 class="mb-0">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="me-2" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M5 11.5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5zm-3 1a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm0 4a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm0 4a1 1 0 1 0 0-2 1 1 0 0 0 0 2z"/>
                        </svg>
                        Your Expenses
                    </h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.Expenses.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0 expense-table">
                                <thead>
                                    <tr>
                                        <th class="ps-4">Expense Name</th>
                                        <th class="text-end pe-4">Amount</th>
                                        <th class="text-center">Delete</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var expense in Model.Expenses)
                                    {
                                        <tr>
                                            <td class="ps-4 py-3">
                                                <strong style="color: #37474f;">@expense.Description</strong>
                                            </td>
                                            <td class="text-end pe-4">
                                                <strong style="color: #2e7d32;">₱@expense.Amount.ToString("N0")</strong>
                                            </td>
                                            <td class="text-center">
                                                <form asp-action="Delete" asp-route-id="@expense.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-delete" onclick="return confirm('Remove this expense?')">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                                            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/>
                                                            <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/>
                                                        </svg>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="text-muted mb-3" viewBox="0 0 16 16">
                                <path d="M14 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h12zM2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H2z"/>
                                <path d="M3 3.5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5zM3 6a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9A.5.5 0 0 1 3 6zm0 2.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5z"/>
                            </svg>
                            <p class="text-muted mb-0">No expenses yet. Add your first expense!</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>