@page
@model IndexModel
@{
    ViewData["Title"] = "Personal Expense Tracker";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body>
    <div class="container">
        <div class="header">
            <h1><i class="fas fa-wallet"></i> Expense Tracker</h1>
            <p>Track your daily expenses easily 💰</p>
        </div>

        <div class="form-section">
            <form method="post">
                <div class="form-group">
                    <label for="ExpenseName">Expense Name</label>
                    <input type="text" id="ExpenseName" name="ExpenseName" required 
                           placeholder="e.g., Coffee, Groceries" value="@Model.TempExpenseName" />
                </div>
                <div class="form-group">
                    <label for="Amount">Amount (PHP)</label>
                    <input type="number" id="Amount" name="Amount" step="0.01" min="0" required 
                           placeholder="0.00" value="@Model.TempAmount" />
                </div>
                <button type="submit" class="btn">Add Expense <i class="fas fa-plus"></i></button>
            </form>
        </div>

        <div class="expenses-section">
            @if (Model.Expenses.Any())
            {
                <table class="expenses-table">
                    <thead>
                        <tr>
                            <th><i class="fas fa-list"></i> Expense</th>
                            <th><i class="fas fa-money-bill-wave"></i> Amount</th>
                            <th><i class="fas fa-trash"></i> Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var expense in Model.Expenses)
                        {
                            <tr>
                                <td><strong>@expense.Name</strong></td>
                                <td>₱@expense.Amount.ToString("N2")</td>
                                <td>
                                    <form method="post" style="display: inline;">
                                        <input type="hidden" name="DeleteId" value="@expense.Id" />
                                        <button type="submit" class="delete-btn" 
                                                onclick="return confirm('Delete @expense.Name?')">
                                            <i class="fas fa-trash"></i> Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-inbox"></i>
                    <h3>No expenses yet</h3>
                    <p>Add your first expense above!</p>
                </div>
            }
        </div>

        <div class="total-section">
            <div class="total-display @(Model.Total >= 1000 ? "total-warning" : "")">
                Total: ₱@Model.Total.ToString("N2")
            </div>
            @if (Model.Total >= 1000)
            {
                <p style="color: #ff6b6b; font-weight: 600;">
                    <i class="fas fa-exclamation-triangle"></i> Warning: High spending!
                </p>
            }
            else
            {
                <p style="color: #4facfe;">You're doing great! 👍</p>
            }
        </div>
    </div>
</body>
</html>